{
  "name": "atendimento-multicanal-backend",
  "type": "commonjs",
  "private": true,
  "version": "0.1.0",
   "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.unit.config.cjs --runInBand",
    "test:e2e": "npx dotenv -e .env.test -o -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest-e2e.config.cjs --runInBand",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.unit.config.cjs --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest"
  }
}
